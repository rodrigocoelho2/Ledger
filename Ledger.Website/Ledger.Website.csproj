<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Ledger, the app (MVC): the landing page, sign-in and the screens, for the phone and the computer. Talks to
       Ledger.WebApi only through Ledger.Sdk. -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <UserSecretsId>ledger-website-6b0e93d1</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ledger.Sdk\Ledger.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ledger.UnitTest" />
  </ItemGroup>

</Project>
