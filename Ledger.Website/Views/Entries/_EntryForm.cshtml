@model EntryFormModel
@{
    // The form that adds an entry or changes one. The page script loads it into the dialog and shows only the
    // categories (and the extra fields) that fit the kind and the part of life picked.
    var entry = Model.Entry;
    var editing = !string.IsNullOrEmpty(entry?.Id);
    var modules = Model.RentalEnabled || Model.FlipsEnabled;
    var picked = entry?.Category;
    var account = entry?.AccountId ?? Model.Accounts.FirstOrDefault()?.Id;
    var to = entry?.ToAccountId;
    var categories = Categories.All.Where(category =>
        category.In(EntryScope.Personal)
        || (Model.RentalEnabled && category.In(EntryScope.Rental))
        || (Model.FlipsEnabled && category.In(EntryScope.Flips)));
}
<form class="sheet-body" data-ajax data-entry-form action="/entries/save" method="post" autocomplete="off">
    <div class="sheet-top">
        <h2>@(editing ? L.T("Change entry", "Alterar movimento") : L.T("New entry", "Novo movimento"))</h2>
        <button type="button" class="icon-btn bare" data-close aria-label="@L.T("Close", "Fechar")">@Icons.Get("x")</button>
    </div>
    <input type="hidden" name="id" value="@entry?.Id" />

    <div class="seg full" role="radiogroup" aria-label="@L.T("Kind", "Tipo")">
        <input type="radio" name="kind" id="kind-out" value="Outflow" checked="@(Model.Kind == EntryKind.Outflow)" /><label for="kind-out">@L.T("Outflow", "Saída")</label>
        <input type="radio" name="kind" id="kind-in" value="Inflow" checked="@(Model.Kind == EntryKind.Inflow)" /><label for="kind-in">@L.T("Inflow", "Entrada")</label>
        <input type="radio" name="kind" id="kind-move" value="Transfer" checked="@(Model.Kind == EntryKind.Transfer)" /><label for="kind-move">@L.T("Transfer", "Transferência")</label>
    </div>

    <div class="amount">
        <label class="eyebrow" for="entry-amount" data-amount-label data-plain="@L.T("Amount", "Valor")" data-total="@L.T("Total price", "Preço total")">@L.T("Amount", "Valor")</label>
        <div class="amount-row">
            <span aria-hidden="true">€</span>
            <input id="entry-amount" type="text" name="amount" inputmode="decimal" placeholder="@L.Input(0m)" value="@L.Input(entry is { Amount: > 0 } ? entry.Amount : (decimal?)null)" required autofocus="@(!editing)" />
        </div>
    </div>

    <label class="field">
        <span>@L.T("What was it?", "O que foi?")</span>
        <input type="text" name="name" maxlength="120" value="@entry?.Name" placeholder="@L.T("Lunch, salary, electricity…", "Almoço, salário, eletricidade…")" required />
    </label>

    @if (modules)
    {
        <div class="field" data-for-kinds="Outflow Inflow">
            <span class="field-label">@L.T("Belongs to", "Pertence a")</span>
            <div class="picks" role="radiogroup">
                <input type="radio" name="scope" id="scope-personal" value="Personal" checked="@(Model.Scope == EntryScope.Personal)" /><label for="scope-personal">@L.T("Personal", "Pessoal")</label>
                @if (Model.RentalEnabled)
                {
                    <input type="radio" name="scope" id="scope-rental" value="Rental" checked="@(Model.Scope == EntryScope.Rental)" /><label for="scope-rental" style="--pick:var(--brass)"><span class="dot" style="background:var(--brass)"></span>@L.T("Rental", "Alojamento")</label>
                }
                @if (Model.FlipsEnabled)
                {
                    <input type="radio" name="scope" id="scope-flips" value="Flips" checked="@(Model.Scope == EntryScope.Flips)" /><label for="scope-flips" style="--pick:var(--mauve)"><span class="dot" style="background:var(--mauve)"></span>@L.T("Buy & Sell", "Compra & Venda")</label>
                }
            </div>
        </div>
    }
    else
    {
        <input type="hidden" name="scope" value="Personal" />
    }

    <div class="field" data-for-kinds="Outflow Inflow">
        <span class="field-label">@L.T("Category", "Categoria")</span>
        <div class="picks" role="radiogroup" data-categories>
            @foreach (var category in categories)
            {
                <span data-kind="@category.Kind" data-scopes="@string.Join(' ', category.Scopes)">
                    <input type="radio" name="category" id="cat-@category.Kind-@category.Key" value="@category.Key" checked="@(picked == category.Key && category.Kind == Model.Kind)" /><label for="cat-@category.Kind-@category.Key" style="--pick:@category.Color"><span class="dot" style="background:@category.Color"></span>@category.Name(L.Code)</label>
                </span>
            }
        </div>
    </div>

    @if (Model.RentalEnabled)
    {
        <div class="field-row" data-for-booking hidden>
            <label class="field">
                <span>@L.T("Nights", "Noites")</span>
                <input type="number" class="mono" name="nights" min="0" max="366" inputmode="numeric" value="@entry?.Nights" />
            </label>
            <label class="field">
                <span>@L.T("Came through", "Veio por")</span>
                <input type="text" name="channel" maxlength="40" list="channels" value="@entry?.Channel" placeholder="Airbnb" />
                <datalist id="channels"><option value="Airbnb"></option><option value="Booking"></option><option value="@L.T("Direct", "Direto")"></option></datalist>
            </label>
        </div>
    }

    @if (Model.FlipsEnabled)
    {
        <div data-for-scope="Flips" hidden>
            <label class="field">
                <span>@L.T("Project", "Projeto")</span>
                <select name="projectId" data-project>
                    @foreach (var (id, projectName) in Model.Projects)
                    {
                        <option value="@id" selected="@(Model.ProjectId == id)">@projectName</option>
                    }
                    <option value="" selected="@(Model.Projects.Count == 0)">@L.T("+ A new project…", "+ Um projeto novo…")</option>
                </select>
            </label>
            <label class="field" data-new-project hidden>
                <span>@L.T("Name of the new project", "Nome do projeto novo")</span>
                <input type="text" name="projectName" maxlength="80" placeholder="@L.T("T2 Bela Vista", "T2 Bela Vista")" />
            </label>
        </div>
    }

    <div class="field">
        <span class="field-label" data-label-account data-plain="@L.T("Account", "Conta")" data-from="@L.T("From", "De")">@L.T("Account", "Conta")</span>
        <div class="acct-picks" role="radiogroup">
            @foreach (var item in Model.Accounts)
            {
                <span>
                    <input type="radio" name="accountId" id="acct-@item.Id" value="@item.Id" checked="@(account == item.Id)" /><label for="acct-@item.Id"><b>@item.Name</b><span>@L.Money(item.Balance)</span></label>
                </span>
            }
        </div>
    </div>

    <div class="field" data-for-kinds="Transfer" hidden>
        <span class="field-label">@L.T("To", "Para")</span>
        <div class="acct-picks" role="radiogroup">
            @foreach (var item in Model.Accounts)
            {
                <span>
                    <input type="radio" name="toAccountId" id="to-@item.Id" value="@item.Id" checked="@(to == item.Id)" /><label for="to-@item.Id"><b>@item.Name</b><span>@L.Money(item.Balance)</span></label>
                </span>
            }
        </div>
    </div>

    @if (!editing)
    {
        @* Paid in instalments: one entry per month, each on its day; the amount above is the total. *@
        <div class="plan" data-for-kinds="Outflow">
            <label class="check plan-switch">
                <input type="checkbox" name="inInstalments" value="true" data-plan-toggle />
                <span>@L.T("Pay in instalments, interest-free", "Pagar em prestações, sem juros")</span>
            </label>
            <div class="plan-body" data-plan hidden>
                <div class="field" style="margin-top:6px">
                    <span class="field-label">@L.T("How many instalments", "Quantas prestações")</span>
                    <div class="plan-count">
                        @foreach (var preset in new[] { 3, 6, 10, 12, 24 })
                        {
                            <button type="button" class="chip-btn" data-parts="@preset" aria-pressed="@(preset == 3 ? "true" : "false")">@preset</button>
                        }
                        <input type="number" class="in-box mono" name="instalments" min="@Instalments.Fewest" max="@Instalments.Most" value="3" inputmode="numeric" aria-label="@L.T("Number of instalments", "Número de prestações")" />
                    </div>
                </div>
                <label class="field">
                    <span>@L.T("First instalment", "Primeira prestação")</span>
                    <input type="date" class="mono" name="firstInstalment" value="@Model.FirstInstalment.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)" />
                </label>
                <div class="field">
                    <span class="field-label">@L.T("The others", "As seguintes")</span>
                    <div class="picks" role="radiogroup">
                        <input type="radio" name="rule" id="rule-first" value="first-business-day" checked /><label for="rule-first">@L.T("1st business day of each month", "1.º dia útil de cada mês")</label>
                        <input type="radio" name="rule" id="rule-same" value="same-day" /><label for="rule-same">@L.T("Same day each month", "Mesmo dia de cada mês")</label>
                    </div>
                </div>
                <p class="plan-preview" data-plan-preview
                   data-one="@L.T("{n} instalments of {a}", "{n} prestações de {a}")"
                   data-first="@L.T("{n} instalments: the first {f}, then {a}", "{n} prestações: a primeira de {f}, depois {a}")"></p>
                <p class="note" style="margin-top:4px">@L.T("Each instalment is an entry in its month. The balance only moves on the day each one is paid.", "Cada prestação é um movimento no seu mês. O saldo só mexe no dia em que cada uma é paga.")</p>
            </div>
        </div>
    }

    <label class="field" data-day>
        <span>@L.T("Day", "Dia")</span>
        <input type="date" class="mono" name="date" value="@Model.Day.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)" required />
    </label>

    @if (entry is { PlanId: not null, PlanPart: { } planPart, PlanParts: { } planParts })
    {
        <div class="plan-info">
            <div>
                <b>@L.T($"Instalment {planPart} of {planParts}", $"Prestação {planPart} de {planParts}")</b>
                <span>@L.T("Changes here touch only this instalment.", "O que mudares aqui só mexe nesta prestação.")</span>
            </div>
            <button type="button" class="btn small danger" data-post="/entries/delete-plan" data-id="@entry.PlanId" data-confirm>@Icons.Get("trash")@L.T("Delete the whole plan", "Apagar o plano todo")</button>
        </div>
    }

    <div class="form-msg" hidden role="alert"></div>
    <div class="form-foot">
        @if (editing)
        {
            <button type="button" class="btn danger" data-post="/entries/delete" data-id="@entry!.Id" data-confirm>@Icons.Get("trash")<span class="sr">@L.T("Delete entry", "Apagar movimento")</span></button>
        }
        <button type="submit" class="btn primary">@(editing ? L.T("Save changes", "Guardar alterações") : L.T("Save entry", "Guardar movimento"))</button>
    </div>
</form>
