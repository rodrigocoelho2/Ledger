@model Ledger.Website.Model.Account.AccountPageModel
@* A new account with Discord: Discord already said who this is, so only the user name is left to pick. *@
@{
    ViewData["Title"] = L.T("Create account", "Criar conta");
    ViewData["Tab"] = "create";
}

<div class="au">
    <partial name="_AccountSide" model="Model" />

    <main class="au-main">
        <form class="au-form" method="post" action="/create-account/discord" autocomplete="off">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

            <h1>@L.T("Almost there", "Quase lá")</h1>
            <p class="lead">@L.T("You're signed in to Discord as", "Entraste no Discord como") <b>@Model.DiscordName</b>. @L.T("Pick a user name for Ledger.", "Escolhe um nome de utilizador para o Ledger.")</p>

            <partial name="_AccountCard" model="Model" />

            <label class="field">
                <span>@L.T("User name", "Nome de utilizador")</span>
                <span class="au-in">
                    @Icons.Get("user")
                    <input name="userName" type="text" value="@Model.UserName" autocapitalize="none" spellcheck="false" pattern="[A-Za-z0-9._\-]{3,32}" required autofocus />
                </span>
                <small class="hint">@L.T("3–32 letters, numbers, dots, dashes or underscores.", "3–32 letras, números, pontos, hífenes ou underscores.")</small>
            </label>

            <button class="btn primary wide" type="submit"><span class="discord-mark" aria-hidden="true"></span>@L.T("Create account with Discord", "Criar conta com o Discord")</button>

            <p class="au-fine">@L.T("Already have an account here?", "Já tens conta aqui?") <a href="/sign-in">@L.T("Sign in with your password", "Entra com a palavra-passe")</a>@L.T(", then link Discord in Settings to keep your ledger.", " e depois liga o Discord nas Definições para manteres o teu livro.")</p>
        </form>
    </main>
</div>
