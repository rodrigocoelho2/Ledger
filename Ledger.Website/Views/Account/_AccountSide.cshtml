@model Ledger.Website.Model.Account.AccountPageModel
@{
    var active = (string)ViewData["Tab"]!;
    var first = Model.IsFirstAccount && active == "create";
    var create = active == "create" && !first;
    var back = Context.Request.Path.Value + Context.Request.QueryString.Value;
}
@* The side of the sign-in and create-account pages: brand, a headline and an example page of the ledger (a header on the phone). *@
<aside class="au-side">
    <div class="au-top">
        <a class="brand" href="/about">@Icons.Logo()Ledger</a>
        <nav class="lang-switch" aria-label="@L.T("Language", "Idioma")">
            <a href="/language/en?returnUrl=@Uri.EscapeDataString(back)" aria-current="@(L.Pt ? null : "true")">EN</a>
            <a href="/language/pt?returnUrl=@Uri.EscapeDataString(back)" aria-current="@(L.Pt ? "true" : null)">PT</a>
        </nav>
    </div>
    <div>
        @if (first)
        {
            <h2>@L.T("Open the", "Abre o") <em>@L.T("first page.", "primeiro livro.")</em></h2>
            <p>@L.T("Create the first account. It becomes the admin and can let everyone else in the house have their own ledger.", "Cria a primeira conta. Fica como admin e pode deixar o resto da casa ter o seu próprio livro.")</p>
        }
        else if (create)
        {
            <h2>@L.T("Every euro,", "Cada euro,") <em>@L.T("in its place.", "no seu lugar.")</em></h2>
            <p>@L.T("A ledger of your own: what came in, what went out and what was left, month by month.", "Um livro só teu: o que entrou, o que saiu e o que sobrou, mês a mês.")</p>
        }
        else
        {
            <h2>@L.T("Welcome back.", "Bem-vindo de volta.") <em>@L.T("Let's balance the books.", "Vamos fechar as contas.")</em></h2>
            <p>@L.T("Sign in to see how the month is going.", "Entra para ver como vai o mês.")</p>
        }
    </div>
    <div class="au-card" aria-hidden="true">
        <span class="eyebrow">@L.T("Net for October", "Saldo de outubro")</span>
        <div class="figure pos">+@L.Money(827.16m)</div>
        <div class="row">
            <div class="row-date"><b>14</b>@L.T("OCT", "OUT")</div>
            <div class="row-main"><span class="row-name">@L.T("Lunch", "Almoço")</span><span class="row-sub"><span class="dot" style="background:#E39468"></span>@L.T("Groceries & food", "Alimentação")</span></div>
            <span class="row-amt outflow">−@L.Money(9.80m)</span>
        </div>
        <small>@L.T("Example numbers.", "Números de exemplo.")</small>
    </div>
</aside>
