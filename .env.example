# Copy this file to ".env" (next to docker-compose.yml) and fill it in.
# .env holds secrets: don't share it or put it in git.
# No spaces around "=". If a value has # or spaces, wrap it in single quotes: 'a#b c'.

# ---------- Required ----------

# The shared SQL Server's sa password: the same value as SQL_SA_PASSWORD in shared-sql's .env. Only db-deploy uses it,
# to create the Ledger database and the ledger login.
SQL_SA_PASSWORD=Change-Me-2026!

# The password of the ledger login, which the WebApi connects with (it only sees the Ledger database). Make up a new one:
# letters and numbers, 20+ characters (in bash:  echo "Aa1$(LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 24)").
# db-deploy creates the login, and sets this password again on every deploy, so changing it here is all it takes.
SQL_APP_PASSWORD=change-this-to-a-long-random-password

# Internal key between the website and the WebApi. Another long random string.
LEDGER_API_KEY=change-this-to-a-long-random-key

# Asked for only when creating the FIRST account (the admin), so nobody else on the network can create it before you.
LEDGER_SETUP_KEY=change-this

# ---------- Sign in with Discord (optional) ----------

# One Discord application can serve all your apps: https://discord.com/developers/applications → your app → OAuth2.
# Copy the Client ID and (Reset Secret) the Client Secret here, and under Redirects add this app's address followed by
# /signin-discord, e.g. https://ledger.prometheus-nas.com/signin-discord (one line per address you open Ledger at).
# Already have an account? Sign in with your password and press "Link Discord" in Settings. Someone new can sign up
# with Discord (while LEDGER_ALLOW_REGISTRATION is on).
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# ---------- Optional ----------

# The shared SQL Server's container name, on the sql-net network.
# SQL_SERVER=shared-sql

# false = after the first account, nobody can create one from the sign-in page.
# LEDGER_ALLOW_REGISTRATION=true

# The time zone that decides what "today" and "this month" are.
# TIME_ZONE=Europe/Lisbon

# true = run on the sample ledger in memory (sign in as demo / ledger-demo) without touching the database.
# LEDGER_DEMO_MODE=false
# LEDGER_PORT=5100
# LEDGER_CPUS=1
# LEDGER_WEBAPI_MEMORY=384m
# LEDGER_WEBSITE_MEMORY=384m
