<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests: the money maths (overview, rental, projects, balances), quick add, the categories, the CSV and JSON
       files, the demo ledger and the services, run against the in-memory repositories with a fixed clock (no database,
       no network). -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ledger.Library\Ledger.Library.csproj" />
    <ProjectReference Include="..\Ledger.Sdk\Ledger.Sdk.csproj" />
    <ProjectReference Include="..\Ledger.WebApi\Ledger.WebApi.csproj" />
  </ItemGroup>

</Project>
